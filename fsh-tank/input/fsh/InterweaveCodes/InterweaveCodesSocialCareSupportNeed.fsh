ValueSet: InterweaveSocialCareSupportNeed
Id: Interweave-InterweaveSocialCareSupportNeed
Description: "Defines the set of codes that can be used to identify the support need."
* ^name = "Interweave Social Care Support Need"
* include codes from system Interweave-SocialCareSupportNeed


CodeSystem: InterweaveSocialCareSupportNeed
Id: Interweave-SocialCareSupportNeed
Description: "The social care support need."
* ^name = "InterweaveSocialCareSupportNeed"
* ^content = #complete
* ^caseSensitive = true

* #Diet-and-nutrition "managing and maintaining nutrition"
* #Personal-hygiene	"maintaining personal hygiene"
* #Using-the-toilet	"managing toilet needs"
* #Appropriate-clothing	"being appropriately clothed"
* #Making-use-of-home-safely "being able to make use of the adult’s home safely."
* #Habitable-environment "maintaining a habitable home environment"
* #Developing-maintaining-relationship "developing and maintaining family or other personal relationships"
* #Accessing-and-engaging	"accessing and engaging in work, training, education or volunteering"
* #Recreation "making use of necessary facilities or services in the local community including public transport, and recreational facilities or services"
* #Caring-for-children	"carrying out any caring responsibilities the adult/carer has for a child"
* #Caring-responsibilities	"providing care to other persons for whom the carer provides care"
* #Physical-mental-health	"the carer’s physical or mental health is, or is at risk of, deteriorating"
* #Recreational-engagement	"engaging in recreational activities."